[Unit]
Description=herdr server (terminal workspace manager for AI coding agents)
After=default.target

[Service]
Type=simple
ExecStart=%h/.nix-profile/bin/herdr server
Restart=on-failure
RestartSec=5

# Hardening directives are limited to those that work under systemd
# --user mode (no CAP_SETPCAP / CAP_MKNOD / CAP_SYS_TIME available).
# Excluded — fail with status=218/CAPABILITIES under unprivileged
# systemd on Ubuntu 24.04: PrivateDevices, ProtectKernelModules,
# ProtectKernelLogs, ProtectClock, ProtectHostname, RestrictNamespaces,
# CapabilityBoundingSet, AmbientCapabilities, PrivateUsers.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/herdr %h/.local/share/herdr %h/.local/state/herdr %h/.cache/herdr
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @keyring @debug @cpu-emulation @obsolete

[Install]
WantedBy=default.target

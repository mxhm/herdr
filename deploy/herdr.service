[Unit]
Description=herdr server (terminal workspace manager for AI coding agents)
After=default.target

[Service]
Type=simple
ExecStart=%h/.nix-profile/bin/herdr server
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/herdr %h/.local/share/herdr %h/.local/state/herdr %h/.cache/herdr
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @keyring @debug @cpu-emulation @obsolete
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=default.target

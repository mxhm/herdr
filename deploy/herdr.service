[Unit]
Description=herdr server (terminal workspace manager for AI coding agents)
After=network.target

[Service]
Type=simple
User=max
Group=max
WorkingDirectory=/home/max
ExecStart=/home/max/.nix-profile/bin/herdr server
Restart=on-failure
RestartSec=5

Environment=PATH=/home/max/.nix-profile/bin:/home/max/.local/share/mise/shims:/home/max/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/max

# System-unit hardening for a single-user dev box.
#
# Pane shells AND their children (bwx/bwrap, agents) inherit these
# restrictions — so directives that hide user files or break
# mount/namespace setup are off the menu.
#
# Excluded (would break the multiplexer's primary use case):
#   - PrivateTmp=yes: hides host /tmp from pane shells; user's bwx
#     workspaces under /tmp become unreachable.
#   - ProtectHome=read-only: pane shells can't edit user files; ReadWrite-
#     Paths whitelist is too restrictive for a general multiplexer.
#   - SystemCallFilter=~@mount / RestrictNamespaces=yes: bwx/bwrap need
#     mount(2) + unshare() to set up agent sandboxes.
#   - SystemCallFilter=~@privileged: zsh calls setfsuid at startup.
#   - ProtectControlGroups=yes: blocks bwrap's cgroup-namespace probe.
#
# What's still in: system-binary read-only (ProtectSystem=strict),
# capability drops (CapabilityBoundingSet, AmbientCapabilities),
# minimal /dev (PrivateDevices), kernel protections (Tunables/Modules/
# Logs/Clock/Hostname), JIT-spray defeat (MemoryDenyWriteExecute),
# limited socket families.

NoNewPrivileges=yes
ProtectSystem=strict
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@keyring @debug @cpu-emulation @obsolete
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
